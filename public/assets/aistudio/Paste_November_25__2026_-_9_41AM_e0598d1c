## Шаг 1 — клон и скрипт

```bat
git clone https://github.com/Teodorox/livecut-ai.git livecut-en
cd livecut-en
```

Сохрани файл ниже как `apply_en_patch.py` в корне `livecut-en` (кодировка **UTF-8**):

```python
#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
livecut-ai -> livecut-en  |  EN GTA6 edition patch kit
Запуск:  python apply_en_patch.py   (из корня клона, Python 3.10+)
Делает бэкапы в _backup_pre_en/, проверяет каждую правку, пишет PATCH_REPORT.txt.
Повторный запуск безопасен (уже применённое пропускается).
"""
import ast, re, shutil, sys, pathlib

if hasattr(sys.stdout, "reconfigure"):
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")

ROOT = pathlib.Path(__file__).resolve().parent
BACKUP = ROOT / "_backup_pre_en"
RESULTS, CRIT_FAIL = [], 0

def record(status, rel, label, critical):
    global CRIT_FAIL
    RESULTS.append((status, rel, label, critical))
    if status == "FAIL" and critical:
        CRIT_FAIL += 1
    print(f"[{status:4}] {rel}: {label}")

def backup(rel):
    src, dst = ROOT / rel, BACKUP / rel
    if src.exists() and not dst.exists():
        dst.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(src, dst)

def patch(rel, old, new, label, critical=True, regex=False):
    p = ROOT / rel
    if not p.exists():
        record("FAIL", rel, label + " (нет файла)", critical); return
    src = p.read_text(encoding="utf-8")
    if regex:
        if re.search(old, src, re.DOTALL):
            out = re.sub(old, lambda m: new, src, count=1, flags=re.DOTALL)
        elif new in src:
            record("SKIP", rel, label + " (уже применено)", critical); return
        else:
            record("FAIL", rel, label, critical); return
    else:
        if old in src:
            out = src.replace(old, new)
        elif new in src:
            record("SKIP", rel, label + " (уже применено)", critical); return
        else:
            record("FAIL", rel, label, critical); return
    backup(rel)
    p.write_text(out, encoding="utf-8")
    if rel.endswith(".py"):
        try:
            ast.parse(out)
        except SyntaxError as e:
            shutil.copy2(BACKUP / rel, p)
            record("FAIL", rel, label + f" (СИНТАКСИС, откачено: {e})", True); return
    record("OK", rel, label, critical)

def write_new(rel, content, label, overwrite=False):
    p = ROOT / rel
    if p.exists() and not overwrite:
        alt = p.with_name(p.stem + ".en" + p.suffix)
        alt.write_text(content, encoding="utf-8")
        record("SKIP", rel, label + f" (существует -> записал {alt.name})", True); return
    backup(rel)
    p.write_text(content, encoding="utf-8")
    record("OK", rel, label, True)

if not (ROOT / "clipper" / "main.py").exists():
    sys.exit("Запусти меня из корня клона livecut-ai (рядом должна быть папка clipper/).")


{
  "name": "livecut-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --port=4173 --host=127.0.0.1",
    "clean": "rm -rf dist kit-dist",
    "lint": "eslint . && tsc --noEmit",
    "format": "prettier --write .",
    "test": "tsx --test src/utils/generator.test.ts src/utils/zip.test.ts src/utils/validation.test.ts tests/golden.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage src/utils/generator.test.ts src/utils/zip.test.ts src/utils/validation.test.ts tests/golden.test.ts",
    "test:golden:update": "tsx scripts/update-golden.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "make:kit": "tsx scripts/make-kit.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "lucide-react": "^0.546.0",
    "prettier": "^3.10.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
